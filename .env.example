# === Обязательные ===
# Строка подключения к PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/taxi

# Токен бота MAX (для входа через мини-приложение и уведомлений водителям)
MAX_BOT_TOKEN=

# === Опциональные ===
# Публичный адрес приложения (для cookie Secure и ссылок). Если не задан — определяется из запроса.
APP_BASE_URL=https://example.com

# Адрес OSRM для построения маршрутов (по умолчанию https://router.project-osrm.org)
OSRM_BASE_URL=https://router.project-osrm.org

# SMTP для отправки анкет водителей на модерацию
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
